{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SportsballGo",
  "mainBinaryName": "SportsballGo",
  "version": "0.1.0",
  "identifier": "app.sportsballgo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Sportsball Go", "width": 1200, "height": 800, "minWidth": 420, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://site.api.espn.com https://statsapi.mlb.com https://api-web.nhle.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
